@using ExamSystem.Models.TableModel
@using ExamSystem.Comm.CommHelper
@model List<AdminUser>
@{
    ViewBag.Title = "管理员列表";
    Layout = "~/Views/Shared/_LayoutOtherMaster.cshtml";
}
<div class="x-nav">
    <span class="layui-breadcrumb">
        <a href="">后台首页</a>
        <a href="">管理员管理</a>
    </span>
    <a class="layui-btn layui-btn-small" style="line-height:1.6em;margin-top:3px;float:right" onclick="location.reload()" title="刷新">
        <i class="layui-icon layui-icon-refresh" style="line-height:30px"></i>
    </a>
</div>
<div class="layui-fluid">
    <div class="layui-row layui-col-space15">
        <div class="layui-col-md12">
            <div class="layui-card">
                <div class="layui-card-body ">
                    <form class="layui-form layui-col-space5" method="get">
                        <div class="layui-inline layui-show-xs-block">
                            <input type="text" name="Keys" placeholder="请输入关键字(账号或姓名)" autocomplete="off" class="layui-input" style="width: 200px;">
                        </div>
                        <div class="layui-inline layui-show-xs-block">
                            <button class="layui-btn" lay-submit="" lay-filter="sreach"><i class="layui-icon">&#xe615;</i></button>
                        </div>
                    </form>
                </div>
                <div class="layui-card-header">
                    <button class="layui-btn layui-btn-danger" onclick="delAll()"><i class="layui-icon"></i>批量删除</button>
                    <button class="layui-btn" onclick="xadmin.open('添加管理员','/AdminUser/AddAdmin',600,500)"><i class="layui-icon"></i>添加</button>
                </div>
                <div class="layui-card-body layui-table-body layui-table-main">
                    <table class="layui-table layui-form">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" lay-filter="checkall" name="" lay-skin="primary">
                                </th>
                                <th>ID</th>
                                <th>用户账号</th>
                                <th>姓名</th>
                                <th>电话号码</th>
                                <th>创建时间</th>
                                <th>状态</th>
                                <th style="width:150px;">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (AdminUser adminUser in Model)
                            {
                                string userid = "";
                                if (!(Session["LoginUser"] is null))
                                {
                                    AdminUser userNow = Session["LoginUser"] as AdminUser;
                                    userid = userNow.id.ToString();
                                }
                                string Id = adminUser.id.ToString();
                                int isUserStatus = adminUser.adminStatus;
                                <tr>
                                    <td>
                                        <input type="checkbox" name="id" value="@Id" lay-skin="primary">
                                    </td>
                                    <td>@Id</td>
                                    <td>@adminUser.userName</td>
                                    <td>@adminUser.realName</td>
                                    <td>@adminUser.telPhone</td>
                                    <td>@adminUser.createTime</td>
                                    <td class="td-status">
                                        @if (isUserStatus == 1)
                                        {
                                            <span class="layui-btn layui-btn-normal layui-btn-mini">已启用</span>
                                        }
                                        else
                                        {
                                            <span class="layui-btn layui-btn-disabled layui-btn-mini">已停用</span>
                                        }
                                    </td>
                                    <td class="td-manage">
                                        @if (isUserStatus == 1)
                                        {
                                            if (userid == Id)
                                            {
                                                <button type="button" class="layui-btn layui-btn-sm layui-btn-disabled" title="停用" style="width: 33px;margin-right:4px; height: 28px; height: 26px; line-height: 27px; padding: 0 6px; ">
                                                    <i class="layui-icon">&#xe601;</i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="layui-btn layui-btn-primary layui-btn-sm" onclick="member_stop(this,'@Id')" href="javascript:;" title="启用" style="width: 33px; height: 28px; background-color: #16b777; height: 26px; line-height: 27px; padding: 0 6px; ">
                                                    <i class="layui-icon">&#xe601;</i>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <button type="button" class="layui-btn layui-btn-primary layui-btn-sm" onclick="member_stop(this,'@Id')" href="javascript:;" title="停用" style="width: 33px; height: 28px; background-color: #16b777; height: 26px; line-height: 27px; padding: 0 6px; ">
                                                <i class="layui-icon">&#xe601;</i>
                                            </button>
                                        }
                                        <button type="button" title="编辑" class="layui-btn layui-btn-sm" style=" height: 26px; margin-left: -3px; line-height: 27px; padding: 0 6px;" onclick="xadmin.open('编辑管理员', '/AdminUser/EditAdmin?id=@Id', 600, 350)" href="javascript:;">
                                            <i class="layui-icon layui-icon-edit"></i>
                                        </button>
                                        <button type="button" class="layui-btn layui-btn-primary layui-btn-sm" onclick="xadmin.open('编辑密码','/AdminUser/EditAdminPass?id=@Id', 600, 350)" title="修改密码" href="javascript:;" style="width: 33px; height: 28px; background-color: #ffb800; margin-left: -1px; height: 26px; line-height: 27px; padding: 0 6px; ">
                                            <i class="layui-icon">&#xe631;</i>
                                        </button>
                                        @if (userid == Id)
                                        {
                                            <button type="button" class="layui-btn layui-btn-sm layui-btn-disabled" title="删除"  style="width: 33px; height: 28px; margin-left: -4px; height: 26px; line-height: 27px; padding: 0 6px; ">
                                                <i class="layui-icon">&#xe640;</i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="layui-btn layui-btn-sm layui-btn-danger" title="删除" onclick="member_del(this,'@Id')" href="javascript:;" style="width: 33px; height: 28px; background-color: #ff5722; margin-left: -4px; height: 26px; line-height: 27px; padding: 0 6px; ">
                                                <i class="layui-icon">&#xe640;</i>
                                            </button>
                                        }

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="layui-card-body ">
                    <div class="page">
                        <div>
                            @Html.OutPutPage((int)ViewBag.NowSize, (int)ViewBag.PageSize, (int)ViewBag.TotalCount)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    layui.use(['laydate', 'form'], function () {
        var laydate = layui.laydate;
        var form = layui.form;


        // 监听全选
        form.on('checkbox(checkall)', function (data) {

            if (data.elem.checked) {
                $('tbody input').prop('checked', true);
            } else {
                $('tbody input').prop('checked', false);
            }
            form.render('checkbox');
        });

        //执行一个laydate实例
        laydate.render({
            elem: '#start' //指定元素
        });

        //执行一个laydate实例
        laydate.render({
            elem: '#end' //指定元素
        });


    });

    /*用户-停用*/
    function member_stop(obj, id) {
        var title = $(obj).attr('title') == "启用" ? "停用" : "启用";
        layer.confirm('确认要' + title + '吗？', function (index) {
            //发送请求get
            $.ajax({
                url: '/AdminUser/UpdateStatus?id=' + id,
                type: 'get',
                data: index.filed,
                dataType: 'json',
                success: function (data) {
                    if (data.ResultType == 1) {
                        layer.alert(data.Msg, { icon: 6 });
                        if ($(obj).attr('title') == '启用') {
                            //发异步把用户状态进行更改
                            $(obj).attr('title', '停用')
                            $(obj).find('i').html('&#xe62f;');
                            $(obj).parents("tr").find(".td-status").find('span').addClass('layui-btn-disabled').html('已停用');
                        } else {
                            $(obj).attr('title', '启用')
                            $(obj).find('i').html('&#xe601;');
                            $(obj).parents("tr").find(".td-status").find('span').removeClass('layui-btn-disabled').html('已启用');
                        }
                    }
                    else if (data.ResultType == 3) {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                    else {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                },
            });
        });
    }

    /*用户-删除*/
    function member_del(obj, id) {
        layer.confirm('确认要删除吗？', function (index) {
            //发送请求get
            $.ajax({
                url: '/AdminUser/DeleteAdminUser?id=' + id,
                type: 'get',
                data: index.filed,
                dataType: 'json',
                success: function (data) {
                    if (data.ResultType == 1) {
                        layer.alert(data.Msg, { icon: 6 });
                        $(obj).parents("tr").remove();
                    }
                    else if (data.ResultType == 2) {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                    else {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                },
            });
        });
    }


    //批量删除
    function delAll(argument) {
        var ids = [];

        // 获取选中的id
        $('tbody input').each(function (index, el) {
            if ($(this).prop('checked')) {
                ids.push($(this).val())
            }
        });
        if (ids.length == 0) {
            layer.alert("至少选中一项", { icon: 2 });
            return;
        }
        layer.confirm('确认要删除所选项吗？', function (index) {
            //捉到所有被选中的，发异步进行删除
            $.post('/AdminUser/MutipleDeleteAdmin', { 'ids': ids },
                function (data) {
                    if (data.ResultType == 1) {
                        layer.alert(data.Msg, { icon: 6 });
                        $(".layui-form-checked").not('.header').parents('tr').remove();
                    }
                    else {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                },
                'json'
            );
        });
    }
</script>


