@using ExamSystem.Models.TableModel
@using ExamSystem.Comm.CommHelper 
@model List<Question>
@{
    ViewBag.Title = "题库信息";
    Layout = "~/Views/Shared/_LayoutOtherMaster.cshtml";
}
<div class="x-nav">
    <span class="layui-breadcrumb">
        <a href="">后台首页</a>
        <a href="">题库管理</a>
    </span>
    <a class="layui-btn layui-btn-small" style="line-height:1.6em;margin-top:3px;float:right" onclick="location.reload()" title="刷新">
        <i class="layui-icon layui-icon-refresh" style="line-height:30px;"></i>
    </a>
</div>
<div class="layui-fluid">
    <div class="layui-row layui-col-space15">
        <div class="layui-col-md12">
            <div class="layui-card">
                <div class="layui-card-body ">
                    <form class="layui-form layui-col-space5">
                        <div class="layui-inline layui-show-xs-block">
                            <input type="text" name="Keys" placeholder="请输入关键字(题目或选项)" autocomplete="off" class="layui-input" style="width: 200px;">
                        </div>
                        <div class="layui-inline layui-show-xs-block">
                            <button class="layui-btn" lay-submit="" lay-filter="sreach"><i class="layui-icon">&#xe615;</i></button>
                        </div>
                    </form>
                </div>
                <div class="layui-card-header">
                    <button class="layui-btn layui-btn-danger" onclick="delAll()"><i class="layui-icon"></i>批量删除</button>
                    <button class="layui-btn" onclick="xadmin.open('添加单选题目','/ExamTextQuestion/AddSingleQuestion',800,560)"><i class="layui-icon"></i>添加单选题</button>
                    <button class="layui-btn" onclick="xadmin.open('添加判断题目','/ExamTextQuestion/AddJudgeQuestion',800,500)"><i class="layui-icon"></i>添加判断题</button>
                    <button class="layui-btn" onclick="xadmin.open('添加填空题目','/ExamTextQuestion/AddFillQuestion',800,500)"><i class="layui-icon"></i>添加填空题</button>
                </div>
                <div class="layui-card-body layui-table-body layui-table-main">
                    <table class="layui-table layui-form" style="table-layout: fixed;">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" lay-filter="checkall" name="" lay-skin="primary">
                                </th>
                                <th>ID</th>
                                <th style="width: 200px;">试题题目</th>
                                <th  style="width: 100px;">试题选项</th>
                                <th>试题分数</th>
                                <th>试题答案</th>
                                <th>所属学科</th>
                                <th>试题类型</th>
                                <th>试题难度</th>
                                <th>创建时间</th>
                                <th>试卷状态</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Question examTextQuest in Model)
                            {
                                string type = examTextQuest.questionType;
                                string Id = examTextQuest.id.ToString();
                                int isQuestionStatus = examTextQuest.questionStatus;
                            <tr>
                                <td>
                                    <input type="checkbox" name="id" value="@Id" lay-skin="primary">
                                </td>
                                <td>@Id</td>
                                <td style="white-space: nowrap;text-overflow: ellipsis;overflow: hidden;">@examTextQuest.questionName</td>
                                <td style="white-space: nowrap;text-overflow: ellipsis;overflow: hidden;">@examTextQuest.questionList</td>
                                <td>@examTextQuest.questionScore</td>
                                <td style="white-space: nowrap;text-overflow: ellipsis;overflow: hidden;">@examTextQuest.questionAnswer</td>
                                <td>@examTextQuest.questionSubject</td>
                                <td>@examTextQuest.questionType</td>
                                <td>@examTextQuest.questionRank</td>
                                <td>@examTextQuest.questionCreateTime</td>
                                <td class="td-status">
                                    @if (isQuestionStatus == 1)
                                    {
                                        <span class="layui-btn layui-btn-normal layui-btn-mini">已启用</span>
                                    }
                                    else
                                    {
                                        <span class="layui-btn layui-btn-disabled layui-btn-mini">已停用</span>
                                    }
                                </td>
                                <td class="td-manage">
                                    @if (isQuestionStatus == 1)
                                    {
                                        <a onclick="member_stop(this,'@Id')" href="javascript:;" title="启用">
                                            <i class="layui-icon">&#xe601;</i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a onclick="member_stop(this,'@Id')" href="javascript:;" title="停用">
                                            <i class="layui-icon">&#xe601;</i>
                                        </a>
                                    }
                                    @if (type == "单选题")
                                    {
                                        <a title="编辑" onclick="xadmin.open('编辑题目', '/ExamTextQuestion/EditQuestion?id=@Id',800,500)" href="javascript:;">
                                            <i class="layui-icon">&#xe642;</i>
                                        </a>
                                    }
                                    else if (type == "判断题")
                                    {
                                        <a title="编辑" onclick="xadmin.open('编辑题目', '/ExamTextQuestion/EditJudgeQuestion?id=@Id',800,500)" href="javascript:;">
                                            <i class="layui-icon">&#xe642;</i>
                                        </a>
                                    }
                                    else if (type == "填空题")
                                    {
                                        <a title="编辑" onclick="xadmin.open('编辑题目', '/ExamTextQuestion/EditFillQuestion?id=@Id',800,500)" href="javascript:;">
                                            <i class="layui-icon">&#xe642;</i>
                                        </a>
                                    }
                                    <a title="删除" onclick="member_del(this,'@Id')" href="javascript:;">
                                        <i class="layui-icon">&#xe640;</i>
                                    </a>
                                </td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="layui-card-body ">
                    <div class="page">
                        <div>
                            @Html.OutPutPage((int)ViewBag.NowSize, (int)ViewBag.PageSize, (int)ViewBag.TotalCount)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    layui.use(['laydate', 'form'], function () {
        var laydate = layui.laydate;
        var form = layui.form;


        // 监听全选
        form.on('checkbox(checkall)', function (data) {

            if (data.elem.checked) {
                $('tbody input').prop('checked', true);
            } else {
                $('tbody input').prop('checked', false);
            }
            form.render('checkbox');
        });

        //执行一个laydate实例
        laydate.render({
            elem: '#start' //指定元素
        });

        //执行一个laydate实例
        laydate.render({
            elem: '#end' //指定元素
        });


    });

    /*试题-停用*/
    function member_stop(obj, id) {
        var title = $(obj).attr('title') == "启用" ? "停用" : "启用";
        layer.confirm('确认要' + title + '吗？', function (index) {
            //发送请求get
            $.ajax({
                url: '/ExamTextQuestion/UpdateStatus?id=' + id,
                type: 'get',
                data: index.filed,
                dataType: 'json',
                success: function (data) {
                    if (data.ResultType == 1) {
                        layer.alert(data.Msg, { icon: 6 });
                        if ($(obj).attr('title') == '启用') {
                            //发异步把用户状态进行更改
                            $(obj).attr('title', '停用')
                            $(obj).find('i').html('&#xe62f;');
                            $(obj).parents("tr").find(".td-status").find('span').addClass('layui-btn-disabled').html('已停用');
                        } else {
                            $(obj).attr('title', '启用')
                            $(obj).find('i').html('&#xe601;');
                            $(obj).parents("tr").find(".td-status").find('span').removeClass('layui-btn-disabled').html('已启用');
                        }
                    }
                    else if (data.ResultType == 3) {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                    else {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                },
            });
        });
    }

    /*试题-删除*/
    function member_del(obj, id) {
        layer.confirm('确认要删除吗？', function (index) {
            //发送请求get
            $.ajax({
                url: '/ExamTextQuestion/DeleteQuestion?id=' + id,
                type: 'get',
                data: index.filed,
                dataType: 'json',
                success: function (data) {
                    if (data.ResultType == 1) {
                        layer.alert(data.Msg, { icon: 6 });
                        $(obj).parents("tr").remove();
                    }
                    else if (data.ResultType == 3) {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                    else {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                },
            });
        });
    }

    //批量删除
    function delAll(argument) {
        var ids = [];

        // 获取选中的id
        $('tbody input').each(function (index, el) {
            if ($(this).prop('checked')) {
                ids.push($(this).val())
            }
        });
        if (ids.length == 0) {
            layer.alert("至少选中一项", { icon: 2 });
            return;
        }
        layer.confirm('确认要删除所选项吗？', function (index) {
            //捉到所有被选中的，发异步进行删除
            $.post('/ExamTextQuestion/MutipleDeleteQuestion', { 'ids': ids },
                function (data) {
                    if (data.ResultType == 1) {
                        layer.alert(data.Msg, { icon: 6 });
                        $(".layui-form-checked").not('.header').parents('tr').remove();
                    }
                    else {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                },
                'json'
            );
        });
    }
</script>


