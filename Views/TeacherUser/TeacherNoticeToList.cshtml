@using ExamSystem.Models.TableModel
@using ExamSystem.Comm.CommHelper
@model List<System_Stu_Notice>
@{
    ViewBag.Title = "教学通知";
    Layout = "~/Views/Shared/_LayoutOtherMaster.cshtml";
}
<div class="x-nav">
    <span class="layui-breadcrumb">
        <a href="">后台首页</a>
        <a href="">教学通知</a>
    </span>
    <a class="layui-btn layui-btn-small" style="line-height:1.6em;margin-top:3px;float:right" onclick="location.reload()" title="刷新">
        <i class="layui-icon layui-icon-refresh" style="line-height:30px"></i>
    </a>
</div>
<div class="layui-fluid">
    <div class="layui-row layui-col-space15">
        <div class="layui-col-md12">
            <div class="layui-card">
                <div class="layui-card-body">
                    <form class="layui-form layui-col-space5">
                        <div class="layui-inline layui-show-xs-block">
                            <input type="text" name="Keys" placeholder="请输入关键字(通知名称或内容)" autocomplete="off" class="layui-input" style="width: 200px;">
                        </div>
                        <div class="layui-inline layui-show-xs-block">
                            <button class="layui-btn" lay-submit="" lay-filter="sreach"><i class="layui-icon">&#xe615;</i></button>
                        </div>
                    </form>
                </div>
                <div class="layui-card-header">
                    <button class="layui-btn layui-btn-danger" onclick="delAll()"><i class="layui-icon"></i>批量删除</button>
                    <button class="layui-btn" onclick="xadmin.open('发布通知','/System_Stu_Notice/PublishToStudents',750,300)"><i class="layui-icon"></i>发布通知</button>
                </div>
                <div class="layui-card-body layui-table-body layui-table-main">
                    <table class="layui-table layui-form">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" lay-filter="checkall" name="" lay-skin="primary">
                                </th>
                                <th>ID</th>
                                <th>发布者</th>
                                <th>通知名称</th>
                                <th>通知内容</th>
                                <th>通知创建时间</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (System_Stu_Notice Notice in Model)
                            {
                                string Id = Notice.id.ToString();
                                <tr>
                                    <td style=" width: 10px;">
                                        <input type="checkbox" name="id" value="@Id" lay-skin="primary">
                                    </td>
                                    <td style=" width: 10px;">@Id</td>
                                    <td style=" width: 20px;">@Notice.Publisher</td>
                                    <td style="white-space: nowrap; text-overflow: ellipsis; overflow: hidden; max-width: 80px;width:135px;">@Notice.NoticeName</td>
                                    <td style="white-space: nowrap; text-overflow: ellipsis; overflow: hidden; max-width: 80px;">@Notice.NoticeContent</td>
                                    <td style=" width: 105px;">@Notice.NoticeCreateTime</td>
                                    <td class="td-manage" style="width: 130px;">
                                        <a class="layui-btn layui-btn-xs" onclick="xadmin.open('重新发布','/System_Stu_Notice/EditSystemNotice?id=@Id',750,300)" href="javascript:;">重新发布</a>
                                        <a class="layui-btn layui-btn-danger layui-btn-xs" title="删除" onclick="member_del(this,'@Id')" href="javascript:;">删除</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="layui-card-body ">
                    <div class="page">
                        <div>
                            @Html.OutPutPage((int)ViewBag.NowSize, (int)ViewBag.PageSize, (int)ViewBag.TotalCount)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    layui.use(['laydate', 'form'], function () {
        var laydate = layui.laydate;
        var form = layui.form;

        // 监听全选
        form.on('checkbox(checkall)', function (data) {

            if (data.elem.checked) {
                $('tbody input').prop('checked', true);
            } else {
                $('tbody input').prop('checked', false);
            }
            form.render('checkbox');
        });
        //执行一个laydate实例
        laydate.render({
            elem: '#start' //指定元素
        });
        //执行一个laydate实例
        laydate.render({
            elem: '#end' //指定元素
        });
    });


    /*通告-删除*/
    function member_del(obj, id) {
        layer.confirm('确认要删除吗？', function (index) {
            //发送请求get
            $.ajax({
                url: '/System_Stu_Notice/DeleteStuNotice?id=' + id,
                type: 'get',
                data: index.filed,
                dataType: 'json',
                success: function (data) {
                    if (data.ResultType == 1) {
                        layer.alert(data.Msg, { icon: 6 });
                        $(obj).parents("tr").remove();
                    }
                    else if (data.ResultType == 3) {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                    else {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                },
            });
        });
    }

    //批量删除
    function delAll(argument) {
        var ids = [];

        // 获取选中的id
        $('tbody input').each(function (index, el) {
            if ($(this).prop('checked')) {
                ids.push($(this).val())
            }
        });
        if (ids.length == 0) {
            layer.alert("至少选中一项", { icon: 2 });
            return;
        }
        layer.confirm('确认要删除所选项吗？', function (index) {
            //捉到所有被选中的，发异步进行删除
            $.post('/System_Stu_Notice/MutipleDeleteStuNotice', { 'ids': ids },
                function (data) {
                    if (data.ResultType == 1) {
                        layer.alert(data.Msg, { icon: 6 });
                        $(".layui-form-checked").not('.header').parents('tr').remove();
                    }
                    else {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                },
                'json'
            );
        });
    }
</script>




