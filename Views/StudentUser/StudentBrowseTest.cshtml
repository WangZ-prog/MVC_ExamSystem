@using ExamSystem.Models.TableModel
@using ExamSystem.Comm.CommHelper
@model List<stuScore>
@{
    ViewBag.Title = "成绩查询";
    Layout = "~/Views/Shared/_LayoutOtherMaster.cshtml";
}
<div class="x-nav">
    <a class="layui-btn layui-btn-small" style="line-height:1.6em;margin-top:3px;float:right" onclick="location.reload()" title="刷新">
        <i class="layui-icon layui-icon-refresh" style="line-height:30px"></i>
    </a>
</div>
<div class="layui-fluid">
    <div class="layui-row layui-col-space15">
        <div class="layui-col-md12">
            <div class="layui-card">
                <div class="layui-card-body " style=" text-align: center; font-weight: bold; color: #5a7c86; font-size: 18px;letter-spacing: 44px;">
                    <h1 style="margin-top: 17px; font-weight: bold;">我的测试成绩表</h1>
                </div>
                <div class="layui-card-header">
                    <button class="layui-btn layui-btn-danger" style=" margin-left: 315px;" onclick="delAll()"><i class="layui-icon"></i>批量删除</button>
                </div>
                <div class="layui-card-body layui-table-body layui-table-main" style="width: 60%; margin: auto; ">
                    <table class="layui-table layui-form" align="center">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" lay-filter="checkall" name="" lay-skin="primary">
                                </th>
                                <th style="font-size: 18px;">测试卷号</th>
                                <th style="font-size: 18px;">测试卷学科</th>
                                <th style="font-size: 18px;">我的测试成绩</th>
                                <th style="font-size: 18px;">测试时间</th>
                                <th style="font-size: 18px;">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (stuScore score in Model)
                            {
                                string id = score.testid.ToString();
                            <tr>
                                <td>
                                    <input type="checkbox" name="id" value="@id" lay-skin="primary">
                                </td>
                                <td style="font-size: 15px;">@score.testid </td>
                                <td style="font-size: 15px;">@score.testSubject </td>
                                <td style="font-size: 15px; color: red;">@score.isScore 分</td>
                                <td style="font-size: 15px;">@score.testTime</td>
                                <td class="td-manage" style="width: 155px;">
                                    <a class="layui-btn layui-btn-xs" onclick="look_test(this,'@id')" href="javascript:;">浏览测试卷</a>
                                    <a class="layui-btn layui-btn-danger layui-btn-xs" onclick="test_del(this,'@id')" href="javascript:;">删除</a>
                                </td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="layui-card-body ">
                    <div class="page">
                        <div>
                            @Html.OutPutPage((int)ViewBag.NowSize, (int)ViewBag.PageSize, (int)ViewBag.TotalCount)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    layui.use(['laydate', 'form'], function () {
        var laydate = layui.laydate;
        var form = layui.form;

        // 监听全选
        form.on('checkbox(checkall)', function (data) {

            if (data.elem.checked) {
                $('tbody input').prop('checked', true);
            } else {
                $('tbody input').prop('checked', false);
            }
            form.render('checkbox');
        });
        //执行一个laydate实例
        laydate.render({
            elem: '#start' //指定元素
        });
        //执行一个laydate实例
        laydate.render({
            elem: '#end' //指定元素
        });
    });

    /*测试记录-浏览*/
    function look_test(obj, id) {
        layer.confirm('确认要浏览测试记录吗？', function (index) {
            window.location.href = "/StudentUser/StudentBrowseTestContent?id=" + id;
        });
    }

    /*测试记录-删除*/
    function test_del(obj, id) {
        layer.confirm('确认要删除测试记录吗？', function (index) {
            //发送请求get
            $.ajax({
                url: '/StudentUser/DeleteTest?id=' + id,
                type: 'get',
                data: index.filed,
                dataType: 'json',
                success: function (data) {
                    if (data.ResultType == 1) {
                        layer.alert(data.Msg, { icon: 6 });
                        $(obj).parents("tr").remove();
                    }
                    else if (data.ResultType == 3) {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                    else {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                },
            });
        });
    }

    //批量删除
    function delAll(argument) {
        var ids = [];

        // 获取选中的id
        $('tbody input').each(function (index, el) {
            if ($(this).prop('checked')) {
                ids.push($(this).val())
            }
        });
        if (ids.length == 0) {
            layer.alert("至少选中一项", { icon: 2 });
            return;
        }
        layer.confirm('确认要删除所选项吗？', function (index) {
            //捉到所有被选中的，发异步进行删除
            $.post('/StudentUser/MutipleDeleteTest', { 'ids': ids },
                function (data) {
                    if (data.ResultType == 1) {
                        layer.alert(data.Msg, { icon: 6 });
                        $(".layui-form-checked").not('.header').parents('tr').remove();
                    }
                    else {
                        layer.alert(data.Msg, { icon: 2 });
                    }
                },
                'json'
            );
        });
    }
</script>






