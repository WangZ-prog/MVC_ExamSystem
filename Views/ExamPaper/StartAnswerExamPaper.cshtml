@using ExamSystem.Models.TableModel
@model  ExamPaper
@{
    ViewBag.Title = "开始考试";
    Layout = "~/Views/Shared/_LayoutOtherMaster.cshtml";
    var SingleProblem = (List<Question>)ViewBag.SingleProblem;
    var JudgeProblem = (List<Question>)ViewBag.JudgeProblem;
    var FillProblem = (List<Question>)ViewBag.FillProblem;
    var i = 0;
    var m = 0;
    var n = 0;
    int id = Model.id;
}
<div class="layui-fluid" style="padding-bottom: 50px;">
    <form method="post" onsubmit="return checkForm()" action="/ExamPaper/StartAnswerExamPaper">
        <fieldset class="layui-elem-field" style="background-color: #5fb7b838; width: 99%">
            <legend>试卷说明</legend>
            <div class="layui-field-box">
                <div style="text-align:center;font-size:25px; font-weight:bold;">
                    <label>@Model.examName</label>
                </div>
                <div style="text-align: center; font-weight: bold">
                    <label style="margin-top: 20px;font-size: 14px;display: inline-block;color:rgba(102, 102, 102, 1);margin-left: 32px">试卷学科：@Model.examSubject</label>
                    <label style="margin-top: 20px;font-size: 14px;display: inline-block;color:rgba(102, 102, 102, 1);margin-left: 32px">单选题数：@Model.SinglePNum</label>
                    <label style="margin-top: 20px;font-size: 14px;display: inline-block;color:rgba(102, 102, 102, 1);margin-left: 32px">判断题数：@Model.JudgePNum</label>
                    <label style="margin-top: 20px;font-size: 14px;display: inline-block;color:rgba(102, 102, 102, 1);margin-left: 32px">填空题数：@Model.FillPNum</label>
                    <label style="margin-top: 20px;font-size: 14px;display: inline-block;color:rgba(102, 102, 102, 1);margin-left: 32px">考试总分：@Model.totalScore</label>
                    <label style="margin-top: 20px; font-size: 14px; display: inline-block; color: red; margin-left: 32px">   当前时间：<span id="nowtime"></span></label>
                    <script type="text/javascript">
                        function gettime() {
                            var time = new Date();
                            var arr = new Array("星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六");
                            var hour = time.getHours();
                            var min = time.getMinutes();
                            var sec = time.getSeconds();
                            var madetime = time.getFullYear() + "-" + (time.getMonth() + 1) + "-" + time.getDate() + " " + arr[time.getDay()] + "  " + hour + (min < 10 ? ":0" : ":") + min + (sec < 10 ? ":0" : ":") + sec + (hour < 12 ? " am" : " pm");
                            document.getElementById("nowtime").innerText = madetime;
                        }
                        gettime();//显示第一秒的时间
                        setInterval("gettime()", 1000);
                    </script>
                </div>
            </div>
        </fieldset>
        <hr style="height: 2px; margin-top: 45px; background-color: cadetblue; width: 99%;">
        @if (SingleProblem.Count > 0)
        {
            <blockquote class="layui-elem-quote" style="border-left: 5px solid #9dc08d; font-size: 18px; padding: 7px; margin-top: 10px; background-color: #e4e3e3; width: 97.7%; ">
                一、单选题 (@Model.SinglePNum 个)
            </blockquote>
            foreach (var item in SingleProblem)
            {
                i++;
                <div style="position: relative; background-color: #e9e8e8; width: 99%; font-size: 14px; ">
                    <label style="display: block;font-weight: bold;margin-top: 28px">@i、@item.questionName (  ) [ @SingleProblem[i-1].questionScore 分 ]</label>
                    <input type="hidden" name="SAnswer+@i" value="@item.questionAnswer" />
                    <label style="white-space: pre-line; display: block; margin-top: 15px; font-size: 14px">@item.questionList</label>
                    <div class="layui-form-item" style="width: 100%; height: 38px; background-color: rgba(245, 245, 245, 1); margin-top: 10px">
                        <div class="layui-input-inline" style="width: 500px">
                            <label style=" line-height: 40px; margin-left: 2px; color: rgb(0 0 0); font-weight: bold;">你的答案：</label>
                            <input type="radio" name="SingleAnswer+@i" value="A">A &nbsp;&nbsp;&nbsp;
                            <input type="radio" name="SingleAnswer+@i" value="B">B &nbsp;&nbsp;&nbsp;
                            <input type="radio" name="SingleAnswer+@i" value="C">C &nbsp;&nbsp;&nbsp;
                            <input type="radio" name="SingleAnswer+@i" value="D">D &nbsp;&nbsp;&nbsp;
                        </div>
                    </div>
                </div>
            }
        }
            <hr style="height: 2px; margin-top: 45px; background-color: cadetblue; width: 99%;">
            @if (JudgeProblem.Count > 0)
            {
                <blockquote class="layui-elem-quote" style="border-left: 5px solid #9dc08d; font-size: 18px; padding: 7px; margin-top: 10px; background-color: #e4e3e3; width: 97.7%; ">
                    二、判断题(@Model.JudgePNum 个)
                </blockquote>
                foreach (var item in JudgeProblem)
                {
                    m++;
                    <div class="layui-form-item" style="position: relative; background-color: #e9e8e8; width: 99%; font-size: 14px; ">
                        <label style="display: block;font-weight: bold;margin-top: 28px">@m、@item.questionName  [ @JudgeProblem[m-1].questionScore 分 ]</label>
                        <input type="hidden" name="JAnswer+@m" value="@item.questionAnswer" />
                        <div style="width: 100%; height: 38px; background-color: rgba(245, 245, 245, 1); margin-top: 10px">
                            <div class="layui-input-inline" style="width: 500px">
                                <label style=" line-height: 40px; margin-left: 2px; color: rgb(0 0 0); font-weight: bold;">你的答案：</label>
                                <input type="radio" name="JudgeAnswer+@m" value="对">对 &nbsp;&nbsp;&nbsp;
                                <input type="radio" name="JudgeAnswer+@m" value="错">错 &nbsp;&nbsp;&nbsp;
                            </div>
                        </div>
                    </div>
                }
            }
            <hr style="height: 2px; margin-top: 46px; background-color: cadetblue; width: 99%;">
            @if (FillProblem.Count > 0)
            {
                <blockquote class="layui-elem-quote" style="border-left: 5px solid #9dc08d; font-size: 18px; padding: 7px; margin-top: 10px; background-color: #e4e3e3; width: 97.7%; ">
                    三、填空题 (@Model.FillPNum 个)
                </blockquote>
                foreach (var item in FillProblem)
                {
                    n++;
                    <div style="position: relative; background-color: #e9e8e8; width: 99%; font-size: 14px; ">
                        <label style="display: block;font-weight: bold;margin-top: 28px">@n、@item.questionName [ @FillProblem[n-1].questionScore 分 ]</label>
                        <input type="hidden" name="FAnswer+@n" value="@item.questionAnswer" />
                        <div style="width: 100%; height: 32px; background-color: rgba(245, 245, 245, 1); margin-top: 10px">
                            <input type="text" id="L_FillAnswer" name="FillAnswer+@n" required="" placeholder="你的答案" lay-verify="" autocomplete="off" class="layui-input">
                        </div>
                    </div>
                }
            }
            <div style="text-align: center; height: 50px; width: 97%; position: fixed; bottom: 0; background-color: #ffffff; text-align: center;">
                <button type="submit" class="layui-btn layui-btn-normal layui-btn-radius" style="margin-top: 10px; border-radius: 5px;">提交试卷</button>
                <input type="hidden" name="id" value="@id" />
            </div>
        </form>
    </div>
    <script>
        function checkForm() {
            var inputInline = document.getElementsByClassName("layui-input-inline");
            var count = 0;
            var flag = 0;

            for (i = 0; i < inputInline.length; i++) {
                flag++;
                for (j = 0; j < inputInline[i].childNodes.length; j++) {
                    var radioDom = inputInline[i].childNodes[j];
                    if (radioDom.checked == true) {
                        count++;
                    }
                }
            }
            if (count < flag) {
                layer.alert("请将所有题目完成后再交卷！！！", { icon: 0 });
                return false;
            }
            else {
                if (confirm("确定现在提交试卷吗？？？")) {
                    return true;
                }
                else {
                    return false;
                }
            }
        }
    </script>
